<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_unpicked_warning" model="ir.ui.view">
        <field name="name">account.move.form.unpicked.warning</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Solo el botón "Confirmar" de facturas (no asientos). -->
            <xpath expr="//button[@name='action_post'][@string='Confirm']" position="attributes">
                <attribute name="name">action_post_con_aviso_separacion</attribute>
            </xpath>
        </field>
    </record>
</odoo>
